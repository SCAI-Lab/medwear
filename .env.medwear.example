# MED-API Environment Configuration

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://<user>:<password>@medwear-postgres:5432/<database>
POSTGRES_USER=<your_postgres_user>
POSTGRES_PASSWORD=<your_postgres_password>
POSTGRES_DB=<your_postgres_database>

# Keycloak
KEYCLOAK_URL=http://medwear-keycloak:8080
KEYCLOAK_REALM=medwear
KEYCLOAK_CLIENT_ID=med-api
KEYCLOAK_CLIENT_SECRET=<find_in_keycloak_admin_ui_clients_med-api_credentials>

# InfluxDB
INFLUX_URL=http://medwear-influxdb:8086
INFLUX_TOKEN=<your_influxdb_token>
INFLUX_ORG=<your_influxdb_org>
INFLUX_BUCKET=<your_influxdb_bucket>

# MinIO
MINIO_ROOT_USER=<your_minio_user>
MINIO_ROOT_PASSWORD=<your_minio_password>

# Grafana
GF_SECURITY_ADMIN_PASSWORD=<your_grafana_password>
